# Copy this file's values into real environment variables — do NOT
# commit a real .env to git. Dart Frog reads these via
# Platform.environment (see lib/db.dart and every _middleware.dart).
#
# Locally, export them in your shell before running dart_frog dev:
#   export TURSO_DATABASE_URL="libsql://your-db-yourorg.turso.io"
#   export TURSO_AUTH_TOKEN="eyJhbGciOi..."
#   export JWT_SECRET="pick-a-long-random-string"
#   dart_frog dev
#
# On Render, add the same three under
# Dashboard > your service > Environment.

TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=paste-your-turso-token-here
JWT_SECRET=pick-a-long-random-string
